{
	"schemaVersion": 1,
	"id": "mobesp",
	"version": "${version}",
	"name": "Mob ESP",
	"description": "Advanced mob highlighting mod with customizable colors, search functionality, and performance optimizations. See any mob through walls!",
	"authors": [
		"Ede99"
	],
	"contact": {
		"homepage": "https://github.com/Ede99/Minecraft-Mob-ESP",
		"sources": "https://github.com/Ede99/Minecraft-Mob-ESP"
	},
	"license": "CC0-1.0",
	"icon": "assets/mobesp/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.ede99.mobhighlighter.MobESPMod"
		],
		"client": [
			"com.ede99.mobhighlighter.MobESPModClient"
		]
	},
	"mixins": [
		"mobesp.mixins.json",
		{
			"config": "mobesp.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.16.14",
		"minecraft": "~1.21.1",
		"java": ">=17",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}